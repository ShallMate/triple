load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "triple",
    srcs = ["main.cc"],
    copts = [
        "-std=c++20",
        "-maes",
        "-mpclmul",
        "-msse2",
        "-msse3",
        "-msse4.1",
        "-mavx2",
        "-fpermissive",
    ],
    linkopts = [
        "-no-pie",
        "-Wl,--allow-multiple-definition",
    ],
    deps = [
        "@com_github_osu_crypto_libote//:all_deps",
    ],
)
