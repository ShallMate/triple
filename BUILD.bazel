load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "triple",
    srcs = ["main.cc"],
    copts = [
        "-std=c++20",
        "-I/usr/local/include",
        "-maes",
        "-mpclmul",
        "-msse2",
        "-msse3",
        "-msse4.1",
        "-mavx2",
        "-fpermissive",
    ],
    linkopts = [
        "-no-pie",
        "-Wl,--allow-multiple-definition",
        "-L/usr/local/lib",
        "-Wl,--start-group",
        "-llibOTe",
        "-lSimplestOT",
        "-lKyberOT",
        "-lbitpolymul",
        "-lrelic_s",
        "-lcryptoTools",
        "-lcoproto",
        "-Wl,--end-group",
        "-lssl",
        "-lcrypto",
        "-lsodium",
        "-ldl",
        "-pthread",
    ],
)
